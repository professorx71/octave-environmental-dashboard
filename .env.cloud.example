# ===== PBF Temperature Dashboard v6.0.3 Cloud Edition =====
LICOR_API_TOKEN=PASTE_PRIVATE_LICOR_TOKEN_HERE
LICOR_API_BASE=https://api.licor.cloud

GMAIL_SENDER=your-alert-sender@gmail.com
GMAIL_APP_PASSWORD=PASTE_GMAIL_APP_PASSWORD_HERE
ALERT_EMAIL=recipient@example.com

NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=PASTE_LONG_PRIVATE_TOPIC_HERE

# IMPORTANT: keep FALSE during initial cloud testing to avoid duplicate alarms
# with the GMKtec mini-PC. Change to true only when cloud becomes PRIMARY.
NOTIFICATIONS_ENABLED=false
DEPLOYMENT_ROLE=CLOUD-TEST

# Existing hashed credentials from the mini-PC may be copied here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
